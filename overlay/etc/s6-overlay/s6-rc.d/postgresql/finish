#!/usr/bin/nu

use bf
use bf-postgresql
use bf-s6
bf env load -x postgresql

# Terminate container, unless we are restoring from a backup
# PostgreSQL itself is stopped by s6 using the signal in ./down-signal (SIGINT = fast shutdown)
def main [...args] {
    # check whether or not we are restoring from a backup
    if (bf-postgresql restore is_restoring) {
        bf write debug "A restore operation is running: do not stop PostgreSQL or terminate the container."
        exit 0
    }

    # terminate container
    bf-s6 svc finish --terminate ...$args
}
